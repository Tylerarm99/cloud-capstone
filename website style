* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0f172a;
    color: white;
    line-height: 1.6;
}

/* Navigation */

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;

    padding: 20px 8%;

    background: #020617;

    border-bottom: 1px solid #1e293b;
}

.logo {
    font-size: 22px;
    font-weight: bold;
}

.nav-links {
    display: flex;
    gap: 30px;
}

.nav-links a {
    color: white;
    text-decoration: none;
}

.nav-links a:hover {
    color: #38bdf8;
}

/* Hero */

.hero {
    min-height: 600px;

    display: flex;
    align-items: center;

    padding: 80px 8%;

    background:
        linear-gradient(
            rgba(15, 23, 42, 0.9),
            rgba(15, 23, 42, 0.95)
        );
}

.hero-content {
    max-width: 800px;
}

.welcome {
    color: #38bdf8;

    font-weight: bold;

    letter-spacing: 2px;

    margin-bottom: 20px;
}

h1 {
    font-size: 60px;

    line-height: 1.1;

    margin-bottom: 25px;
}

h1 span {
    color: #38bdf8;
}

.description {
    font-size: 20px;

    color: #cbd5e1;

    max-width: 700px;

    margin-bottom: 35px;
}

/* Buttons */

.buttons {
    display: flex;

    gap: 15px;
}

.button {
    padding: 14px 25px;

    border-radius: 6px;

    text-decoration: none;

    font-weight: bold;
}

.primary {
    background: #38bdf8;

    color: #020617;
}

.secondary {
    border: 1px solid #38bdf8;

    color: #38bdf8;
}

.button:hover {
    opacity: 0.8;
}

/* Services */

.services {
    padding: 80px 8%;

    background: #111827;

    text-align: center;
}

.services h2,
.project h2 {
    font-size: 35px;

    margin-bottom: 40px;
}

.service-container {
    display: grid;

    grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));

    gap: 25px;
}

.service-card {
    padding: 30px;

    background: #1e293b;

    border-radius: 10px;
}

.service-card h3 {
    color: #38bdf8;

    margin-bottom: 15px;
}

.service-card p {
    color: #cbd5e1;
}

/* Project */

.project {
    padding: 80px 8%;

    text-align: center;
}

.project p {
    max-width: 800px;

    margin: auto;

    color: #cbd5e1;
}

.visitor-box {
    margin: 35px auto;

    padding: 20px;

    max-width: 300px;

    background: #1e293b;

    border-radius: 8px;
}

/* Footer */

footer {
    padding: 25px;

    text-align: center;

    background: #020617;

    color: #94a3b8;
}

/* Mobile */

@media (max-width: 700px) {

    nav {
        flex-direction: column;

        gap: 15px;
    }

    h1 {
        font-size: 42px;
    }

    .buttons {
        flex-direction: column;
    }

}
